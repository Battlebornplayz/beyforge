{
  "name": "beyforge",
  "productName": "BeyForge",
  "version": "4.3.0",
  "description": "Design, 3D print and battle custom Beyblades",
  "author": "Battlebornplayz",
  "main": "main.js",
  "scripts": { "dist": "electron-builder --win nsis --publish always" },
  "dependencies": { "electron-updater": "6.3.9" },
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "com.battlebornplayz.beyforge",
    "productName": "BeyForge",
    "files": ["main.js", "preload.js", "app/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "icon.ico", "artifactName": "BeyForge-Setup.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": "always", "shortcutName": "BeyForge" },
    "protocols": [{ "name": "BeyForge", "schemes": ["beyforge"] }],
    "publish": [{ "provider": "github", "owner": "Battlebornplayz", "repo": "beyforge", "releaseType": "release" }]
  }
}
