rules_version = '2';
// BeyForge security rules. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // The owner is the Google account below. Google sign-in emails are verified, so this can't be faked.
    function isOwner() {
      return signedIn() && request.auth.token.email == 'battlebornplayz@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function profile() { return get(/databases/$(database)/documents/users/$(me())).data; }
    function roleOf() { return exists(/databases/$(database)/documents/users/$(me())) ? profile().get('role', 'player') : 'player'; }
    function perms() {
      return exists(/databases/$(database)/documents/roles/$(roleOf()))
        ? get(/databases/$(database)/documents/roles/$(roleOf())).data.get('perms', {}) : {};
    }
    function can(p) { return isOwner() || perms().get(p, false) == true; }
    // fields only staff may change on a profile
    function staffFields() { return ['role', 'banned', 'isOwnerFlag', 'muted', 'mutedUntil', 'shadowBanned', 'flags', 'warnings']; }
    function isStaff() { return isOwner() || can('studio') || can('grant') || can('moderate'); }
    function notBanned() { return !exists(/databases/$(database)/documents/users/$(me())) || profile().get('banned', false) != true; }

    // ---- ranks / roles: everyone can read, only owner or "manageRoles" staff can edit ----
    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if can('manageRoles');
    }

    // ---- unique usernames (for username + password logins) ----
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me() || can('moderate');
    }

    // ---- profiles: public to signed-in players, editable by the owner of the profile ----
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me()
        && !request.resource.data.keys().hasAny(staffFields());
      allow update: if signedIn() && (
          (uid == me() && notBanned() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(staffFields()))
          || can('grant') || can('moderate') );
      allow delete: if uid == me() || isOwner();

      // saved Beys: private unless marked public
      match /beys/{beyId} {
        allow read: if signedIn() && (uid == me() || resource.data.get('public', false) == true || can('moderate') || can('viewPlayers'));
        allow write: if signedIn() && uid == me();
      }
      // owned part copies. IVs (and rarity/shiny/slot) can never be changed by the player —
      // only the owner or staff with the editIV permission.
      match /parts/{pid} {
        function ivOk(iv) {
          return iv.keys().hasOnly(['atk','def','sta','brs','stb'])
            && iv.atk is int && iv.atk >= 0 && iv.atk <= 31 && iv.def is int && iv.def >= 0 && iv.def <= 31
            && iv.sta is int && iv.sta >= 0 && iv.sta <= 31 && iv.brs is int && iv.brs >= 0 && iv.brs <= 31
            && iv.stb is int && iv.stb >= 0 && iv.stb <= 31;
        }
        allow read: if signedIn() && (uid == me() || can('editIV') || can('viewPlayers'));
        allow create: if signedIn() && ((uid == me() && notBanned()) || can('grant')) && ivOk(request.resource.data.iv);
        allow update: if signedIn() && (
            (uid == me() && notBanned() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['iv','rarity','shiny','slot','system']))
            || (can('editIV') && ivOk(request.resource.data.iv)) );
        allow delete: if signedIn() && (uid == me() || can('editIV') || can('grant'));
      }
      // activity log the Studio reads (packs, purchases, gifts, trades, staff actions)
      match /log/{lid} {
        allow read: if signedIn() && (uid == me() || can('viewPlayers'));
        allow create: if signedIn() && (uid == me() || isStaff());
      }
      // friends list entries
      match /friends/{fid} {
        allow read: if signedIn() && (uid == me() || fid == me());
        allow write: if signedIn() && (uid == me() || fid == me());
      }
      // inbox: friend requests, battle invites, gifted Beys, trade offers
      match /inbox/{msgId} {
        allow read, delete: if signedIn() && uid == me();
        // a shop gift must be paid for in the same batch: the sender's coins drop by exactly its cost
        function paidGift() {
          return request.resource.data.get('type', '') != 'giftItem'
            || (request.resource.data.cost is int && request.resource.data.cost > 0 && uid != me()
                && getAfter(/databases/$(database)/documents/users/$(me())).data.coins
                   == get(/databases/$(database)/documents/users/$(me())).data.coins - request.resource.data.cost);
        }
        allow create: if signedIn() && notBanned() && request.resource.data.from == me() && paidGift();
        allow update: if signedIn() && uid == me();
      }
    }

    // ---- public Bey gallery ----
    match /gallery/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && request.resource.data.author == me();
      allow update: if signedIn() && (resource.data.author == me() || can('moderate')
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'downloads']));
      allow delete: if signedIn() && (resource.data.author == me() || can('moderate'));
    }

    // ---- direct-message chats between two players (chatId = sorted uids joined by "_") ----
    match /chats/{chatId} {
      function inChat() { return signedIn() && me() in chatId.split('_'); }
      allow read, write: if inChat() || can('moderate');
      match /messages/{mid} {
        allow read: if inChat() || can('moderate');
        allow create: if inChat() && notBanned() && request.resource.data.from == me()
          && request.resource.data.text is string && request.resource.data.text.size() <= 500;
        allow delete: if signedIn() && (resource.data.from == me() || can('moderate'));
      }
    }

    // ---- trades ----
    match /trades/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me() || can('moderate'));
      allow create: if signedIn() && notBanned() && request.resource.data.from == me();
      allow update: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // ---- app-wide settings & announcements (owner/staff) ----
    match /config/{doc} {
      allow read: if true;
      allow write: if can('manageGame');
    }

    // ---- BeyForge Studio content: custom packs, parts, cosmetics... ----
    // players see live/scheduled items; creators can only save drafts or send for review; publishers can go live
    match /content/{id} {
      allow read: if resource.data.status in ['live', 'scheduled'] || can('createContent') || can('publish');
      allow create, update: if can('publish')
        || (can('createContent') && request.resource.data.status in ['draft', 'review']
            && (resource == null || resource.data.status in ['draft', 'review']));
      allow delete: if can('publish');
      match /versions/{v} {
        allow read: if can('createContent') || can('publish');
        allow create: if can('createContent') || can('publish');
      }
    }
    // ---- audit log: every Studio action, who did it and what it was before ----
    match /audit/{id} {
      allow read: if can('viewAudit');
      allow create: if isStaff() && request.resource.data.by == me();
      allow delete: if isOwner();
    }
    // ---- analytics: players add to daily counters, staff read ----
    match /stats/{d} {
      allow read: if can('viewAnalytics');
      allow create, update: if signedIn();
    }
    match /errors/{id} {
      allow read, delete: if can('viewAnalytics');
      allow create: if request.resource.data.keys().hasOnly(['msg','stack','ver','shell','ua','uid','ts']) && request.resource.data.msg.size() < 400;
    }
  }
}
